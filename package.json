{
  "name": "proshop",
  "version": "1.0.0",
  "description": "MERN e-Commerce app",
  "homepage": "https://github.com/megs-au/proshop#readme",
  "bugs": {
    "url": "https://github.com/megs-au/proshop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megs-au/proshop.git"
  },
  "license": "MIT",
  "author": "Megs",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "nodemon": "^3.1.11"
  }
}
